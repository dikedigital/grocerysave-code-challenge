# Postgres connection used by the API server, migrations and seed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grocerysave

# Separate database for `npm run test:api` (it is wiped on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/grocerysave_test

# Secret used to sign login tokens. Change it outside local development.
JWT_SECRET=change-me

# API server port. The Vite dev server proxies /api to it.
PORT=3001

# Folder holding the mocked supermarket API responses (CSV files).
DATA_DIR=./data

# Minutes between background price refreshes. 0 disables the scheduler.
PRICE_SYNC_INTERVAL_MINUTES=15
